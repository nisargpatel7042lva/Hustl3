# Hustl3 Environment Variables
# Copy this file to .env.local and fill in the values

# --- 0G Storage & Compute (0G Bounty) ---
ZEROG_KV_ENDPOINT=http://localhost:6789
ZEROG_LOG_ENDPOINT=http://localhost:6790
ZEROG_COMPUTE_ENDPOINT=http://localhost:6791
ZEROG_API_KEY=your_0g_api_key
ZEROG_COMPUTE_KEY=your_0g_compute_key
ZEROG_RPC_URL=https://rpc.0g.ai

# --- KeeperHub MCP (KeeperHub Bounty) ---
KEEPERHUB_MCP_URL=https://api.keeperhub.io/mcp/v1
KEEPERHUB_API_KEY=your_keeperhub_api_key

# --- ENS Integration (ENS Bounty) ---
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/demo

# --- Uniswap Trade API (Integration) ---
UNISWAP_API_KEY=your_uniswap_api_key
UNISWAP_ROUTER_ADDRESS=0x3fC91A3afd70395Cd496C647d5a6CC9D4B2b7FAD

# --- Gensyn AXL ---
AXL_NODE_URL=http://localhost:8080

# --- Blockchain & Auth ---
NEXT_PUBLIC_CHAIN_ID=16600
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Authentication
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars

# Operator Wallet (for signing x402 challenges and backend transactions)
OPERATOR_PRIVATE_KEY=your_operator_private_key

# --- Redis (BullMQ & Nonce Store) ---
REDIS_URL=redis://localhost:6379

# --- Smart Contract Addresses (deployed on 0G Chain / Base Sepolia) ---
NEXT_PUBLIC_0G_MARKETPLACE=0xD3d5e44a47AD7b78B410195f7c8983cb1111F227
NEXT_PUBLIC_0G_ESCROW=0xA1272B197c18cCEAce4D575422CD35146E88906f
